ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional — enables live web search in the Regulatory Intelligence agent.
# Sign up free at https://tavily.com (1,000 searches/month on the free tier).
# Leave blank to use only Claude's built-in regulatory knowledge.
TAVILY_API_KEY=

# ── Authentication ──────────────────────────────────────────────────────────
# Shared HTTP Basic login for the whole app.
APP_USERNAME=iawingman
# Set a real password. IMPORTANT: if APP_PASSWORD is empty the API is
# FAIL-CLOSED — every request is rejected with 503 — unless you also set
# IA_WINGMAN_DEV_OPEN=1 below. Never leave this blank in a demo or production.
APP_PASSWORD=

# Escape hatch for local development ONLY: run with authentication disabled when
# APP_PASSWORD is empty. Default false. Never enable outside your own machine.
IA_WINGMAN_DEV_OPEN=false

# Serve FastAPI's interactive docs at /docs + /openapi.json. Handy for a demo;
# set to false to lock them down in a hardened deployment. Default true.
EXPOSE_API_DOCS=true

# Privacy guard (GDPR): HMAC secret for pseudonymisation, at least 32 characters, unique per
# installation. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Empty means the privacy guard refuses to run.
GDPR_PSEUDONYM_KEY=
