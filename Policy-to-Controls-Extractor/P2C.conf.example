[paths]
todo_dir = testdata/to-do
output_dir = testdata/output

[defaults]
# Domein: IAM, Change, Logging, Vendor Risk, of unknown
domain = unknown
# Toepassingsscope: organisatienaam, BU, of unknown
scope = unknown

[anthropic]
# API-sleutel van console.anthropic.com/settings/api-keys
api_key = sk-ant-...

[claude]
# Model: claude-opus-4-6, claude-sonnet-4-6, of claude-haiku-4-5
model = claude-sonnet-4-6
header_model = claude-haiku-4-5