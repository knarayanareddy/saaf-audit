# Copy this file to `.env` and fill in your real key. `.env` is gitignored.
#   PowerShell:  Copy-Item .env.example .env

# Required: your Anthropic API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (claude-opus-4-8)
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: only needed for the webapp's ElevenLabs voice assistant
# (webapp/README.md's "ElevenLabs voice assistant" section). One agent for
# the whole app — not per-engagement, engagement.html only has an on/off
# toggle. ELEVENLABS_API_KEY is your key from
# https://elevenlabs.io/app/settings/api-keys (needs Conversational AI ->
# Signed URL / convai_write permission); never sent to the browser, the
# server uses it only to mint short-lived signed conversation URLs.
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_AGENT_ID=agent_...
