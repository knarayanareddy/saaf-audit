# Anthropic API key for the LLM-backed prompts.
ANTHROPIC_API_KEY=your-key-here

# Optional notification webhook.
MATTERMOST_WEBHOOK_URL=https://your-mattermost/hooks/xxx

# HMAC key for pseudonymisation. REQUIRED — the app refuses to start without
# it, and there is no default: a shared key makes every token reproducible by
# anyone holding the source, which is no longer pseudonymisation under GDPR
# Art. 4(5). Must be at least 32 characters and unique per deployment.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Treat it like a decryption key: rotating it changes every token, so the same
# subject will no longer map to the same pseudonym across datasets.
GDPR_PSEUDONYM_KEY=
