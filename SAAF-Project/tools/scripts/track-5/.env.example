# Track 5 tools — environment variables
#
# Copy this file to .env and fill in your own values.
# .env is gitignored and must NEVER be committed.
#
# This tool is BYOK (Bring Your Own Key). No credentials are distributed
# with this code — every user/org supplies their own key.

# REQUIRED — Anthropic API key for Claude calls
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER-REPLACE-WITH-YOUR-OWN-KEY

# OPTIONAL — RAG backend selector
# Set to "chromadb" if you have Track 0's ChromaDB running locally.
# Default (unset or "markdown") uses the shipped mini_rag_corpus/ fallback.
# RAG_BACKEND=markdown

# OPTIONAL — ChromaDB endpoint (only used if RAG_BACKEND=chromadb)
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8000

# OPTIONAL — Log level for the hallucination pipeline
# LOG_LEVEL=INFO
