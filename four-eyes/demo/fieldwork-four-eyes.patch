+
+def _kit():
+    from agents.four_eyes.testkit import FourEyesBypassTests
+
+    return FourEyesBypassTests
+
+
+class _NotInstalled:
+    """Stand-in before the fix, so the file still loads and reports clearly."""
+
+    def test_four_eyes_is_installed(self):
+        pass
+
+
+try:
+    _Kit = _kit()
+except ImportError:  # before the fix: the kit is not vendored yet
+    _Kit = _NotInstalled
+
+
+class TestFieldworkFourEyesKit(_Kit, unittest.TestCase):
+    STEP = "fieldwork_entry"
+
+    def setUp(self):
+        if _Kit is _NotInstalled:
+            self.fail("Four Eyes is not installed in agents/four_eyes")
+        self._tmp = Path(__import__("tempfile").mkdtemp())
+        self._old_runs = audit_trail_module.RUNS_DIR
+        audit_trail_module.RUNS_DIR = self._tmp
+        state_module.RUNS_DIR = self._tmp
+        super().setUp()
+
+    def tearDown(self):
+        audit_trail_module.RUNS_DIR = self._old_runs
+        state_module.RUNS_DIR = self._old_runs
+
+    def prepare(self, gate):
+        _, entry = _run_with_one_entry()
+        return entry
+
+    def artefact(self, state):
+        from agents.approval_seal import reviewed_content
+
+        return reviewed_content(state)
+
+    def tamper(self, state):
+        return {**state, "response_text": state["response_text"] + " Exception closed."}
+
+    def release(self, gate, state, approval):
+        from agents.approval_seal import STEP
+
