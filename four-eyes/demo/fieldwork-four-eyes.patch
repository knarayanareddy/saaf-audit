new file mode 100644
index 0000000..b4ce7c3
--- /dev/null
+++ b/agents/approval_seal.py
@@ -0,0 +1,97 @@
+"""Four Eyes seals for fieldwork approvals.
+
+Before: an approval was a plain line in ``runs/<run_id>/approvals.jsonl`` with
+a name and "approved". Anyone who could call /approve, or edit the file, could
+satisfy the human sign-off, and the approval did not say *what* was approved,
+so the agent's answer could change afterwards without anyone noticing.
+
+Now an approval carries a Four Eyes seal (see ``agents/four_eyes``):
+- it is signed with ``FOUR_EYES_KEY`` (kept on the server, never in a prompt),
+- it names the logged-in reviewer (the caller passes the authenticated user,
+  never a name from the request body),
+- it is bound to the SHA-256 of exactly the prompt and answer that were
+  reviewed, so editing the answer afterwards invalidates it,
+- the reviewer types ``APPROVE <code>`` naming that exact content.
+
+``orchestrator.require_approved`` checks the seal before anything is finalized.
+Without ``FOUR_EYES_KEY`` nothing can be approved or finalized (fails closed).
+Every approval and refusal is written to ``runs/<run_id>/four-eyes-log.jsonl``,
+signed and chained, so an auditor can re-perform it with
+``python -m agents.four_eyes verify-log runs/<run_id>/four-eyes-log.jsonl``.
+"""
+
+from __future__ import annotations
+
+import json
+
+from agents import audit_trail as _audit_trail
+from agents import four_eyes
+
+STEP = "fieldwork_entry"
+
+# What a reviewer actually looks at when approving one agent call.
+REVIEWED_FIELDS = (
+    "entry_id",
+    "run_id",
+    "agent",
+    "item_ref",
+    "model",
+    "system_prompt",
+    "user_prompt",
+    "response_text",
+)
+
+
+def reviewed_content(entry: dict) -> str:
+    """The exact content an approval covers: the prompt and the answer of one call."""
+    return json.dumps(
+        {field: entry.get(field) for field in REVIEWED_FIELDS},
+        sort_keys=True,
+        ensure_ascii=False,
+    )
+
+
+def approval_phrase(entry: dict) -> str:
+    """What the reviewer types to approve this exact entry."""
+    return f"APPROVE {four_eyes.short_code(reviewed_content(entry))}"
+
+
+def _gate(run_id: str, user: str) -> four_eyes.Gate:
+    return four_eyes.Gate(
+        lambda: user,
+        log_path=_audit_trail.RUNS_DIR / run_id / "four-eyes-log.jsonl",
+    )
+
+
+def seal(
+    run_id: str,
+    entry: dict,
+    *,
+    user: str,
+    confirmation: str,
+    prepared_by: str | None = None,
+) -> dict:
+    """Sign an approval for ``entry`` by the logged-in ``user``.
+
+    Raises ``four_eyes.ApprovalRejected`` when the typed confirmation does not
+    name this exact content, or when ``user`` prepared it (strict four eyes).
+    """
+    approval = _gate(run_id, user).approve(
+        STEP, reviewed_content(entry), confirmation or "", prepared_by=prepared_by
+    )
+    return approval.to_dict()
+
+
+def check(run_id: str, entry: dict, approval_record: dict | None) -> None:
+    """Raise ``four_eyes.FourEyesError`` unless the record carries a valid seal.
+
+    Valid means: signed with this server's key, for exactly this entry's
+    current content, by the reviewer named on the record, not expired.
+    """
+    record = approval_record or {}
+    gate = _gate(run_id, record.get("reviewer") or "")
+    approval = gate.verify(STEP, reviewed_content(entry), record.get("four_eyes"))
+    if approval.approver != record.get("reviewer"):
+        raise four_eyes.ApprovalInvalid(
+            "the name on the approval record is not the person who signed it"
+        )
