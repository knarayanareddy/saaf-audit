+++ b/tests/test_four_eyes_approvals.py
@@ -0,0 +1,278 @@
+"""Four Eyes approvals for FieldworkOrchestration.
+
+Findings (SAAF Security Challenge, 10 November 2026):
+- webapp/server.py api_approve: no login. The caller picks a role and the
+  approval is recorded in the name of whoever is assigned to that role, so
+  anyone can approve as the senior auditor. /finalize then accepts it.
+- approvals.jsonl is plain text: a hand-written "approved" line counts.
+- Approvals point at an entry_id only: the AI's answer can be changed after
+  approval and the old approval still counts.
+
+These tests replay those bypasses. They fail before the fix and pass after it.
+No API key or network needed.
+
+python -m pytest -q tests/test_four_eyes_approvals.py
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+import agents.audit_trail as audit_trail_module  # noqa: E402
+import webapp.state as state_module  # noqa: E402
+from agents.audit_trail import AuditTrail  # noqa: E402
+from agents.orchestrator import ApprovalRequiredError, finalize_run, record_approval  # noqa: E402
+
+KEY = "fieldwork-four-eyes-test-key"
+HEADER = "X-Forwarded-User"
+AUDITOR = "Sam Auditor"
+SENIOR = "Robin Senior"
+
+
+@pytest.fixture(autouse=True)
+def isolated_runs(tmp_path, monkeypatch):
+    """Every test gets its own empty runs/ folder and a Four Eyes key."""
+    monkeypatch.setattr(audit_trail_module, "RUNS_DIR", tmp_path)
+    monkeypatch.setattr(state_module, "RUNS_DIR", tmp_path)
+    monkeypatch.setenv("FOUR_EYES_KEY", KEY)
+    monkeypatch.setenv("FOUR_EYES_TRUSTED_USER_HEADER", HEADER)
+    return tmp_path
+
+
+def _run_with_one_entry():
+    """A run with one agent answer waiting for review, and the assigned team."""
+    trail = AuditTrail()
+    now = datetime.now(timezone.utc)
+    entry = trail.record(
+        agent="pbc_validation",
+        system_prompt="Check the delivered access review against the PBC request.",
+        user_prompt="Access review Q3.pdf",
+        model="test-model",
+        max_tokens=100,
+        thinking=None,
+        response_text="Validated: the access review covers all users. No exceptions.",
+        started_at=now,
+        finished_at=now,
+        item_ref="PBC-01",
+    )
+    state_module.save_state(
+        trail.run_id,
+        {"assigned": {"auditor": AUDITOR, "senior_auditor": SENIOR}, "pbc_list": []},
+    )
+    return trail, entry
+
+
+def _phrase(entry):
+    from agents.approval_seal import approval_phrase
+
+    return approval_phrase(entry)
+
+
+def _client():
+    from fastapi.testclient import TestClient
+    from webapp.server import app
+
+    return TestClient(app)
+
+
+# --------------------------------------------------------------------------
+# The bypasses from today
+# --------------------------------------------------------------------------
+
+
+def test_anyone_can_no_longer_approve_in_the_seniors_name():
+    trail, entry = _run_with_one_entry()
+    response = _client().post(
+        f"/api/runs/{trail.run_id}/approve",
+        json={"entry_id": entry["entry_id"], "decision": "approved", "role": "senior_auditor"},
+    )
+    assert response.status_code == 401, "approval accepted from an anonymous caller"
+    assert trail.approval_status(entry["entry_id"]) == "pending"
+
+
+def test_a_logged_in_person_cannot_approve_in_someone_elses_role():
+    trail, entry = _run_with_one_entry()
+    response = _client().post(
+        f"/api/runs/{trail.run_id}/approve",
+        headers={HEADER: AUDITOR},
+        json={
+            "entry_id": entry["entry_id"],
+            "decision": "approved",
+            "role": "senior_auditor",
+            "confirmation": _phrase(entry),
+        },
+    )
+    assert response.status_code == 403, "the auditor approved as the senior auditor"
+    assert trail.approval_status(entry["entry_id"]) == "pending"
+
+
+def test_process_ignores_a_body_approved_by_and_needs_a_login():
+    trail, _ = _run_with_one_entry()
+    response = _client().post(
+        f"/api/runs/{trail.run_id}/items/PBC-01/process",
+        json={"prompt": "Check the access review.", "approved_by": SENIOR},
+    )
+    assert response.status_code == 401, "a prompt was approved in someone's name without a login"
+
+
+def test_nobody_can_reassign_roles_without_a_login_or_to_themselves():
+    trail, _ = _run_with_one_entry()
+    client = _client()
+    anonymous = client.post(f"/api/runs/{trail.run_id}/update", json={"senior_auditor_name": "Mallory"})
+    assert anonymous.status_code == 401, "roles changed by an anonymous caller"
+    redirect = client.post(f"/api/runs/{trail.run_id}/update", json={"auditee_email": "mallory@example.org"})
+    assert redirect.status_code == 401, "auditee email changed by an anonymous caller"
+    self_assign = client.post(
+        f"/api/runs/{trail.run_id}/update", headers={HEADER: AUDITOR}, json={"senior_auditor_name": AUDITOR}
+    )
+    assert self_assign.status_code == 403, "the auditor made themselves the senior auditor"
+    colleague = client.post(
+        f"/api/runs/{trail.run_id}/update", headers={HEADER: SENIOR}, json={"auditor_name": "Kim Auditor"}
+    )
+    assert colleague.status_code == 200
+    harmless = client.post(f"/api/runs/{trail.run_id}/update", json={"audit_scope": "IT general controls"})
+    assert harmless.status_code == 200  # non-sensitive metadata still editable
+
+
+def test_nothing_to_approve_does_not_finalize():
+    trail, _ = _run_with_one_entry()
+    with pytest.raises(ApprovalRequiredError):
+        finalize_run(trail.run_id, [])
+
+
+def test_a_hand_written_approval_line_does_not_finalize():
+    trail, entry = _run_with_one_entry()
+    with trail.approvals_path.open("a", encoding="utf-8") as handle:
+        handle.write(
+            json.dumps(
+                {
+                    "run_id": trail.run_id,
+                    "entry_id": entry["entry_id"],
+                    "decision": "approved",
+                    "reviewer": SENIOR,
+                    "role": "senior_auditor",
+                    "comment": None,
+                    "reviewed_at": datetime.now(timezone.utc).isoformat(),
+                }
+            )
+            + "\n"
+        )
+    with pytest.raises(ApprovalRequiredError):
+        finalize_run(trail.run_id, [entry["entry_id"]])
+
+
+def test_changing_the_answer_after_approval_does_not_finalize():
+    trail, entry = _run_with_one_entry()
+    record_approval(
+        trail.run_id,
+        entry_id=entry["entry_id"],
+        decision="approved",
+        reviewer=SENIOR,
+        role="senior_auditor",
+        confirmation=_phrase(entry),
+    )
+    lines = trail.path.read_text(encoding="utf-8").splitlines()
+    changed = json.loads(lines[0])
+    changed["response_text"] = "Validated: no exceptions. (Exception for user admin01 removed.)"
+    trail.path.write_text(json.dumps(changed) + "\n", encoding="utf-8")
+    with pytest.raises(ApprovalRequiredError):
+        finalize_run(trail.run_id, [entry["entry_id"]])
+
+
+def test_yes_is_not_an_approval():
+    trail, entry = _run_with_one_entry()
+    response = _client().post(
+        f"/api/runs/{trail.run_id}/approve",
+        headers={HEADER: SENIOR},
+        json={"entry_id": entry["entry_id"], "decision": "approved", "role": "senior_auditor", "confirmation": "yes"},
+    )
+    assert response.status_code == 400
+    assert _phrase(entry) in response.json()["detail"]
+    assert trail.approval_status(entry["entry_id"]) == "pending"
+
+
+def test_the_assigned_senior_approving_this_exact_answer_finalizes():
+    trail, entry = _run_with_one_entry()
+    response = _client().post(
+        f"/api/runs/{trail.run_id}/approve",
+        headers={HEADER: SENIOR},
+        json={
+            "entry_id": entry["entry_id"],
+            "decision": "approved",
+            "role": "senior_auditor",
+            "confirmation": _phrase(entry),
+            # Ignored: the name comes from the login, never from the body.
+            "reviewer": "Somebody Else",
+        },
+    )
+    assert response.status_code == 200, response.text
+    assert trail.latest_approval(entry["entry_id"])["reviewer"] == SENIOR
+    finalized = finalize_run(trail.run_id, [entry["entry_id"]])
+    assert finalized["approved_entries"] == [entry["entry_id"]]
